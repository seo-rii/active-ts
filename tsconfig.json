{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "build",
		"rootDir": ".",
		"strict": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"skipLibCheck": true,
		"lib": ["ES2023"],
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts"],
	"exclude": ["build", "node_modules"]
}
